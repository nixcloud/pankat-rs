# public base URL of the blog incl. subdir, used for the label top left and the Open Graph (social preview) tags
site_url = "https://lastlog.de/blog"

# input and output directory (both served by the webserver)
input = "documents/blog.lastlog.de"

# running pankat will write documents to this location
# these documents can be re-generated easily
output = "documents/output"

# assets are js/css/... files and they can be added to the input directory or used from pankat
assets = "documents/assets"

# pankat specific wasm runtime for interactive changes in the webpage
wasm = "documents/wasm"

# folder where the pankat.sqlite database is located
database = "documents"

# a subdirectory like "/blog", "" or "/foo/bar" 
# lastlog.de/blog uses "/blog"
subdir = ""

# weather to build only the documents or update them in real time using websocket connection
static_build_only = false

# the port for the pankat webserver, point your browser to localhost:5000
port = 5000

# server side secret which signs the admin session cookies (valid for 50 days), changing it
# logs out all sessions; use a long random string, e.g. `openssl rand -hex 32`
# instead of passing the token from here, use PANKAT_JWT_TOKEN environment variable
jwt_token = "not set"

# password of the admin, the only user, for the /login page which gives access to /drafts
# the login is disabled while this or jwt_token is "not set"; or use PANKAT_ADMIN_PASSWORD
admin_password = "not set"

# secret of the github webhook of the documents repository: on `git push` github sends a notification
# to <site_url>/github-webhook (content type application/json, this secret, just the push event)
# and pankat runs `git pull --ff-only` in the input directory, which then gets rebuilt; disabled
# while "not set"; or use PANKAT_GITHUB_WEBHOOK_SECRET
github_webhook_secret = "not set"

# documents/mydir/myarticle.mdwn -> documents/output/myarticle.html with flat being true
flat = true
